#!/bin/bash
# Undo scripts/enable: drop the systemd override and unhide the fcitx5 tray icon.
# Failure cases: theme failure never fails disable; retry after a tray restart
# if fcitx5 was down, or report deferred cleanup after a bounded wait.
set -euo pipefail

theme_pending=0
"$(dirname "$0")/theme" disable || theme_pending=1

DROPIN="$HOME/.config/systemd/user/omarchy-fcitx5.service.d/zz-input-menu.conf"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
STATE="$HOME/.local/state/input-menu-enable.json"
CTL=(org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1)
fcitx_running() { busctl --user --auto-start=no call "${CTL[@]}" State >/dev/null 2>&1; }
# Only real paths are removed: a symlinked ancestor (or file) could redirect the removal anywhere the user can reach.
linked_path() { local p=$1 h=${HOME%/}; while [[ $p == "$h"/* ]]; do [[ -L $p ]] && return 0; p=${p%/*}; done; return 1; }
for managed in DROPIN STATE; do
  if linked_path "${!managed}"; then
    echo "Skipping symlinked path, left as it is (move or unlink it): ${!managed}" >&2
    printf -v "$managed" '%s' /nonexistent-input-menu-skip
  fi
done

if [[ -f $DROPIN ]]; then
  rm "$DROPIN"
  rmdir --ignore-fail-on-non-empty "$(dirname "$DROPIN")"
  systemctl --user daemon-reload
  # Exit + unit restart, not Controller1.Restart: that re-execs with the old arguments.
  busctl --user --auto-start=no call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 Exit 2>/dev/null || true
  sleep 1
  systemctl --user restart omarchy-fcitx5
  if (( theme_pending )); then
    for _ in $(seq 20); do fcitx_running && break; sleep 0.5; done
    if fcitx_running; then
      "$(dirname "$0")/theme" disable && theme_pending=0 || true
    fi
  fi
fi

if [[ -f $STATE ]]; then
  if jq -e '.addedHidden == true' "$STATE" >/dev/null && [[ -f $SHELL_JSON ]]; then
    hidden=$(jq -c '[.bar.layout[]?[]? | select(.id == "omarchy.tray") | .hidden // []][0] // [] | if type == "array" then . else [.] end' "$SHELL_JSON")
    if jq -e 'index("Fcitx")' <<<"$hidden" >/dev/null; then
      section=$(jq -r '.bar.layout | to_entries[] | select(any(.value[]?; .id == "omarchy.tray")) | .key' "$SHELL_JSON" | head -1)
      remaining=$(jq -c 'map(select(. != "Fcitx"))' <<<"$hidden")
      # qs ipc drops an empty JSON array argument; null means no hidden icons.
      [[ $remaining == '[]' ]] && remaining=null
      if ! omarchy-bar set omarchy.tray hidden "$remaining" --json --section "$section"; then
        echo "omarchy-bar set omarchy.tray hidden failed" >&2
        exit 1
      fi
    fi
  fi
  rm "$STATE"
fi
if (( theme_pending )); then
  printf 'Candidate-window theme cleanup deferred; run: %q disable\n' "$(cd "$(dirname "$0")" && pwd)/theme"
fi
echo "Input Menu's tray changes removed."
