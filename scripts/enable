#!/bin/bash
# Let Input Menu read fcitx5: turn on fcitx5's notificationitem addon (Omarchy's
# unit starts fcitx5 with --disable notificationitem) and hide the tray icon
# that addon adds, since Input Menu shows the same thing.
#
# Failure cases this script must handle (checked by verify.sh):
# 1. Addon already on (fcitx5 from /etc/xdg/autostart): change nothing, exit 0.
# 2. Run twice: second run changes nothing, exit 0.
# 3. fcitx5 not running: start it through the unit, then wait for the tray item.
# 4. fcitx5 started outside the unit (/etc/xdg/autostart) or by the unit:
#    Controller1.Restart re-execs with the same arguments, so it would keep
#    --disable. Stop it with Controller1.Exit and start the unit, which now
#    runs without --disable.
# 5. omarchy.tray not in the bar layout: skip hiding, exit 0.
# 6. "Fcitx" already in the tray's hidden list: don't duplicate it.
# 7. Tray item never appears within 10 s: exit 1 with a message.
# 8. Another drop-in already overrides ExecStart with extra flags (-r): keep them.
# 9. --disable lists several addons: remove only notificationitem.
# 10. Already enabled: don't rewrite the drop-in or reload the unit.
# 11. Tray icon was hidden before enable: disable must leave it hidden.
# 12. omarchy-bar set fails: name the failed command and exit non-zero.
# 13. fcitx5 down during a state check: it must stay down (no D-Bus activation).
# 14. --disable all (alone or comma-listed): explicitly enable notificationitem.
# 15. Theme step failure never fails enable.
set -euo pipefail

SCRIPT=${BASH_SOURCE[0]}
while [[ -L $SCRIPT ]]; do
  SCRIPT_DIR=$(cd "$(dirname "$SCRIPT")" && pwd)
  SCRIPT=$(readlink "$SCRIPT")
  [[ $SCRIPT == /* ]] || SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
SCRIPT_DIR=$(cd "$(dirname "$SCRIPT")" && pwd)

DROPIN_DIR="$HOME/.config/systemd/user/omarchy-fcitx5.service.d"
# Load after existing drop-ins such as replace.conf; leave them untouched.
DROPIN="$DROPIN_DIR/zz-input-menu.conf"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
STATE="$HOME/.local/state/input-menu-enable.json"
CTL=(org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1)

fcitx_sni() {
  busctl --user --auto-start=no --json=short get-property -- org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
    org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null |
    jq -r '.data[]' | while IFS= read -r entry; do
      name=${entry%%/*}; path=/${entry#*/}
      [[ $name =~ ^[:A-Za-z0-9._-]+$ && $path =~ ^/[A-Za-z0-9_/]*$ ]] || continue
      [[ $(busctl --user --auto-start=no get-property -- "$name" "$path" org.kde.StatusNotifierItem Id 2>/dev/null) == 's "Fcitx"' ]] && echo "$name" && break
    done
  return 0 # No matching tray item is an expected state, not an error.
}
fcitx_running() { busctl --user --auto-start=no call "${CTL[@]}" State >/dev/null 2>&1; }

# Remove only notificationitem, preserving any other disabled addons.
without_notificationitem() {
  local addon
  local -a addons keep=()
  local IFS=,
  read -r -a addons <<<"$1"
  for addon in "${addons[@]}"; do
    [[ $addon == notificationitem ]] || keep+=("$addon")
  done
  REPLY="${keep[*]-}"
}

# Keep the executable and every other flag in their original order.
desired_command() {
  case $1 in
    *['%$;"']*) echo 'Cannot preserve omarchy-fcitx5 ExecStart containing %, $, ; or "' >&2; return 1 ;;
  esac
  local i value enable_idx=-1 disable_all=0
  local -a args command=()
  read -r -a args <<<"$1"
  ((${#args[@]})) || { echo "Missing omarchy-fcitx5 ExecStart" >&2; return 1; }
  for ((i=0; i<${#args[@]}; i++)); do
    case ${args[i]} in
      --disable)
        i=$((i + 1))
        [[ $i -lt ${#args[@]} ]] || { echo "Missing --disable value" >&2; return 1; }
        without_notificationitem "${args[i]}"
        [[ ,$REPLY, == *,all,* ]] && disable_all=1
        [[ -z $REPLY ]] || command+=(--disable "$REPLY")
        ;;
      --disable=*)
        without_notificationitem "${args[i]#--disable=}"
        [[ ,$REPLY, == *,all,* ]] && disable_all=1
        [[ -z $REPLY ]] || command+=("--disable=$REPLY")
        ;;
      --enable)
        i=$((i + 1))
        [[ $i -lt ${#args[@]} ]] || { echo "Missing --enable value" >&2; return 1; }
        command+=(--enable "${args[i]}")
        enable_idx=$((${#command[@]} - 1))
        ;;
      --enable=*)
        command+=("${args[i]}")
        enable_idx=$((${#command[@]} - 1))
        ;;
      *) command+=("${args[i]}") ;;
    esac
  done
  if (( disable_all )); then
    if (( enable_idx >= 0 )); then
      value=${command[enable_idx]#--enable=}
      if [[ ,$value, != *,notificationitem,* && ,$value, != *,all,* ]]; then
        command[enable_idx]+=",notificationitem"
      fi
    else
      command+=(--enable notificationitem)
    fi
  fi
  REPLY="${command[*]}"
}

if [[ ${1:-} == --self-test ]]; then
  check() {
    desired_command "$1"
    [[ $REPLY == "$2" ]] || { printf 'got: %s\nwant: %s\n' "$REPLY" "$2" >&2; return 1; }
  }
  check '-r --disable notificationitem' '-r'
  check '--disable=clipboard,notificationitem' '--disable=clipboard'
  check '--disable all' '--disable all --enable notificationitem'
  check '--disable=all' '--disable=all --enable notificationitem'
  check '--disable=clipboard,all' '--disable=clipboard,all --enable notificationitem'
  check '-r' '-r'
  check '-r --disable all --enable other' '-r --disable all --enable other,notificationitem'
  echo ok
  exit 0
fi

# Only real paths are written: a symlinked ancestor (or file) could redirect the write anywhere the user can reach.
linked_path() { local p=$1 h=${HOME%/}; while [[ $p == "$h"/* ]]; do [[ -L $p ]] && return 0; p=${p%/*}; done; return 1; }
refuse_directory() {
  [[ ! -d $1 ]] || { echo "Refusing to replace a directory: $1" >&2; return 1; }
}
safe_write_path() {
  if linked_path "$1"; then
    echo "Refusing to use a symlinked path (move or unlink it): $1" >&2
    return 1
  fi
  refuse_directory "$1"
}
for managed in "$DROPIN" "$STATE"; do safe_write_path "$managed" || exit 1; done

sni=$(fcitx_sni)
refresh=1
if [[ -n $sni && -f $DROPIN ]]; then
  # Read the other unit fragments without removing ours. If their desired
  # command already matches our override, a second enable changes nothing.
  base=$(systemctl --user cat omarchy-fcitx5 | awk -v own="$DROPIN" '
    /^# \// { skip = ($0 == "# " own); next }
    !skip && /^ExecStart=./ { command = substr($0, 11) }
    END { print command }
  ')
  # A stock line the rewrite cannot preserve (unexpanded %h, $VAR) cannot be compared: rebuild from the expanded argv.
  if [[ -n $base ]] && desired_command "$base" 2>/dev/null; then
    if [[ $(<"$DROPIN") == $'[Service]\nExecStart=\nExecStart='"$REPLY" ]]; then
      refresh=0
    fi
  fi
fi
# shellcheck disable=SC2034  # published and restarted are read by the EXIT trap inside
if [[ -z $sni || ( -f $DROPIN && $refresh == 1 ) ]]; then
  previous="" backup="" tmp="" rc=0 published=0 restarted=0
  safe_write_path "$DROPIN" || exit 1
  mkdir -p "$DROPIN_DIR"
  if [[ -f $DROPIN ]]; then
    previous=$(<"$DROPIN")
    backup=$(mktemp "$DROPIN_DIR/.previous.XXXXXX")
    cp -p "$DROPIN" "$backup"
  fi
  # Until fcitx5 is back with the tray interface, any failure restores the previous drop-in (or removes ours).
  trap 'rc=$?; if [[ -n $backup ]]; then safe_write_path "$DROPIN" && mv -f -- "$backup" "$DROPIN" || true; elif ((published)); then rm -f -- "$DROPIN" || true; fi; systemctl --user daemon-reload || true; if ((restarted)); then systemctl --user restart omarchy-fcitx5 || true; fi; [[ -z $tmp ]] || rm -f -- "$tmp" || true; exit "$rc"' EXIT
  if [[ -n $backup ]]; then
    rm -- "$DROPIN"
    systemctl --user daemon-reload
  fi
  effective=$(systemctl --user show omarchy-fcitx5 -p ExecStart --value) || { echo "Cannot read omarchy-fcitx5 ExecStart" >&2; exit 1; }
  [[ $effective != *'ignore_errors=yes'* ]] || { echo "Cannot preserve omarchy-fcitx5 ExecStart with ignore_errors=yes" >&2; exit 1; }
  argv=$(sed -n 's/.*argv\[\]=\(.*\) ; ignore_errors=.*/\1/p' <<<"$effective")
  [[ -n $argv ]] || { echo "Cannot read omarchy-fcitx5 ExecStart" >&2; exit 1; }
  # ponytail: systemctl formats argv[] as text; use typed DBus argv if flags ever contain spaces.
  desired_command "$argv"
  new="[Service]
ExecStart=
ExecStart=$REPLY"
  safe_write_path "$DROPIN" || exit 1
  tmp=$(mktemp "$DROPIN_DIR/.input-menu.XXXXXX")
  printf '%s\n' "$new" >"$tmp"
  chmod 644 "$tmp"
  safe_write_path "$DROPIN" || exit 1
  mv -f -- "$tmp" "$DROPIN"
  published=1
  systemctl --user daemon-reload
  if [[ -z $sni || $previous != "$new" ]]; then
    echo "Restarting fcitx5…"
    restarted=1
    if fcitx_running; then
      busctl --user --auto-start=no call "${CTL[@]}" Exit || true
      for _ in $(seq 20); do fcitx_running || break; sleep 0.25; done
    fi
    systemctl --user restart omarchy-fcitx5
    for _ in $(seq 20); do [[ -n $(fcitx_sni) ]] && break; sleep 0.5; done
    [[ -n $(fcitx_sni) ]] || { echo "fcitx5 did not show up for Input Menu; the previous setup was restored. Check: fcitx5-diagnose" >&2; exit 1; }
  fi
  trap - EXIT
  [[ -z $backup ]] || rm -f -- "$backup"
fi
echo "fcitx5 is visible to Input Menu."

if [[ -f $SHELL_JSON ]] && jq -e '[.bar.layout[]?[]? | select(.id == "omarchy.tray")] | length > 0' "$SHELL_JSON" >/dev/null; then
  hidden=$(jq -c '[.bar.layout[]?[]? | select(.id == "omarchy.tray") | .hidden // []][0] | if type == "array" then . elif . == null then [] else [.] end' "$SHELL_JSON")
  if ! jq -e 'index("Fcitx")' <<<"$hidden" >/dev/null; then
    section=$(jq -r '.bar.layout | to_entries[] | select(any(.value[]?; .id == "omarchy.tray")) | .key' "$SHELL_JSON" | head -1)
    safe_write_path "$STATE" || exit 1
    mkdir -p "$(dirname "$STATE")"
    state_backup=""
    if [[ -f $STATE ]]; then
      state_backup=$(mktemp "$STATE.previous.XXXXXX")
      cp -p "$STATE" "$state_backup"
    fi
    state_tmp=$(mktemp "$STATE.XXXXXX")
    trap 'rc=$?; if [[ -n $state_backup ]]; then safe_write_path "$STATE" && mv -f -- "$state_backup" "$STATE" || true; else rm -f -- "$STATE" || true; fi; rm -f -- "$state_tmp" || true; exit "$rc"' EXIT
    printf '{"addedHidden":true}\n' >"$state_tmp"
    safe_write_path "$STATE" || exit 1
    mv -f -- "$state_tmp" "$STATE"
    if ! omarchy-bar set omarchy.tray hidden "$(jq -c '. + ["Fcitx"]' <<<"$hidden")" --json --section "$section"; then
      echo "omarchy-bar set omarchy.tray hidden failed" >&2
      exit 1
    fi
    trap - EXIT
    [[ -z $state_backup ]] || rm -f -- "$state_backup"
    echo "Hid the duplicate fcitx5 tray icon."
  elif [[ ! -f $STATE ]]; then
    safe_write_path "$STATE" || exit 1
    mkdir -p "$(dirname "$STATE")"
    state_tmp=$(mktemp "$STATE.XXXXXX")
    trap 'rm -f -- "$state_tmp" || true' EXIT
    printf '{"addedHidden":false}\n' >"$state_tmp"
    safe_write_path "$STATE" || exit 1
    mv -f -- "$state_tmp" "$STATE"
    trap - EXIT
  fi
fi

"$SCRIPT_DIR/theme" enable --auto || echo 'Candidate window theme step skipped; see the error above.' >&2
